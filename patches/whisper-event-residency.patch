 #endif
 }
 
+// Bring long-idle weights back into physical memory before they are needed.
+//
+// macOS compresses or swaps out the memory of a process that has sat idle for
+// days, so the first inference afterwards pays to fault several GB back in and
+// the user waits through it. requestResidency below is only a GPU page table
+// hint - it neither guarantees nor waits for host memory to be paged in. For a
+// shared buffer all_data is real host memory (vm_allocate), so touch one byte
+// per page to force the page-in synchronously; the caller can then run this off
+// the critical path and know it is done. A private buffer's all_data is only a
+// virtual address placeholder for GPU memory and must never be dereferenced.
+void ggml_metal_buffer_prepare_residency(ggml_metal_buffer_t buf) {
+    if (buf == NULL) {
+        return;
+    }
+
+    if (buf->is_shared && buf->all_data != NULL && buf->all_size > 0) {
+        const size_t size_page = sysconf(_SC_PAGESIZE);
+
+        // volatile: the reads exist for their page faults, so they must not be elided
+        volatile const uint8_t * data = (volatile const uint8_t *) buf->all_data;
+
+        uint8_t acc = 0;
+        for (size_t offs = 0; offs < buf->all_size; offs += size_page) {
+            acc ^= data[offs];
+        }
+        GGML_UNUSED(acc);
+    }
+
+#if defined(GGML_METAL_HAS_RESIDENCY_SETS)
+    if (@available(macOS 15.0, iOS 18.0, tvOS 18.0, visionOS 2.0, *)) {
+        if (buf->rset) {
+            [buf->rset requestResidency];
+        }
+    }
+#endif
+}
