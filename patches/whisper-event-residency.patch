diff --git a/src/whisper.cpp b/src/whisper.cpp
index ea8d031..53cd77f 100644
--- a/src/whisper.cpp
+++ b/src/whisper.cpp
@@ -5,6 +5,10 @@
 #include "ggml-alloc.h"
 #include "ggml-backend.h"
 
+#ifdef GGML_USE_METAL
+#include "ggml-metal.h"
+#endif
+
 #ifdef WHISPER_USE_COREML
 #include "coreml/whisper-encoder.h"
 #endif
@@ -4166,6 +4170,20 @@ const char *whisper_model_type_readable(struct whisper_context * ctx) {
     }
 }
 
+void whisper_request_residency(struct whisper_context * ctx) {
+    if (ctx == nullptr) {
+        return;
+    }
+
+#ifdef GGML_USE_METAL
+    for (ggml_backend_buffer_t buffer : ctx->model.buffers) {
+        ggml_backend_metal_buffer_request_residency(buffer);
+    }
+#else
+    (void) ctx;
+#endif
+}
